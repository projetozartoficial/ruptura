rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }

    // Perfis: qualquer jogador logado pode ver; só o dono escreve o seu.
    match /users/{uid} {
      allow read: if logado();
      allow write: if logado() && request.auth.uid == uid;
    }
    // IDs Nome#TAG (únicos)
    match /nicks/{id} {
      allow read: if logado();
      allow create, update: if logado() && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if logado() && resource.data.uid == request.auth.uid;
    }
    // Online / em sala / em partida
    match /presence/{uid} {
      allow read: if logado();
      allow write: if logado() && request.auth.uid == uid;
    }
    // Pedidos de amizade
    match /friendReqs/{id} {
      allow read: if logado() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if logado() && request.resource.data.from == request.auth.uid;
      allow update: if logado() && resource.data.to == request.auth.uid;
      allow delete: if logado() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    // Convites para sala
    match /invites/{id} {
      allow read: if logado() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create, update: if logado() && request.resource.data.from == request.auth.uid;
      allow delete: if logado() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
    // Salas: usadas só para os jogadores se conectarem (WebRTC)
    match /rooms/{code} {
      allow read, write: if logado();
      match /peers/{pid} {
        allow read, write: if logado();
      }
    }
    // Fila da Ranqueada
    match /queue/{code} {
      allow read, write: if logado();
    }
  }
}
